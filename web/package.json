{
  "name": "relive-the-round-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5177 --strictPort",
    "build": "tsc --noEmit && vite build",
    "build:public": "node scripts/prepare-public.mjs && VITE_REQUIRE_LEVELS=1 pnpm build && node scripts/verify-dist.mjs",
    "preview": "vite preview --port 4177 --strictPort",
    "lint": "tsc --noEmit",
    "og-image": "node scripts/make-og-image.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "pixi.js": "8.23.0",
    "qrcode-generator": "2.0.4"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
